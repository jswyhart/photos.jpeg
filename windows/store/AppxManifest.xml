<?xml version="1.0" encoding="utf-8"?>
<!--
  photos.jpeg as a Microsoft Store package (MSIX).

  The Identity below is the one Partner Center reserved for the app (Product identity page):
  Name, Publisher and PublisherDisplayName must match it exactly or the Store refuses the upload.
  package-store.ps1 fills in the version and the processor architecture and packs this with the app.

  The package is uploaded unsigned: the Store signs it. It cannot be installed by double-clicking
  (Windows only installs signed packages); test the app itself with the ordinary build.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="swyhart.photos.jpeg" Publisher="CN=B5271835-9174-4B0D-BF2E-86DAF19CB359" Version="{VERSION}" ProcessorArchitecture="{ARCH}" />

  <Properties>
    <DisplayName>photos.jpeg</DisplayName>
    <PublisherDisplayName>swyhart</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="PhotosJpeg" Executable="photos.jpeg.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="photos.jpeg" Description="RAW photo and video editor"
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- "Open with" for photos; the app never makes itself the default -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="photos">
            <uap:DisplayName>Photo</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.jpg</uap:FileType>
              <uap:FileType>.jpeg</uap:FileType>
              <uap:FileType>.png</uap:FileType>
              <uap:FileType>.tif</uap:FileType>
              <uap:FileType>.tiff</uap:FileType>
              <uap:FileType>.webp</uap:FileType>
              <uap:FileType>.heic</uap:FileType>
              <uap:FileType>.avif</uap:FileType>
              <uap:FileType>.dng</uap:FileType>
              <uap:FileType>.nef</uap:FileType>
              <uap:FileType>.cr2</uap:FileType>
              <uap:FileType>.cr3</uap:FileType>
              <uap:FileType>.arw</uap:FileType>
              <uap:FileType>.raf</uap:FileType>
              <uap:FileType>.orf</uap:FileType>
              <uap:FileType>.rw2</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- a classic desktop app: needs to read and write the photos the user points it at -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
